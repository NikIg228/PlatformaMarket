{
  "name": "@marketplace/e2e",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "e2e": "node ../../scripts/run-canonical-browser.mjs --config playwright.unified.config.ts",
    "e2e:flow-a": "playwright test tests/flow-a.spec.ts --config playwright.flow-a.config.ts",
    "e2e:flow-b2": "playwright test tests/flow-b2.spec.ts --config playwright.flow-b2.config.ts",
    "e2e:flow-b3": "node ../../scripts/run-canonical-browser.mjs --config playwright.flow-b3-unified.config.ts",
    "e2e:flow-b3:legacy": "playwright test --config playwright.flow-b3.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "e2e:legacy": "playwright test",
    "e2e:performance": "node ../../scripts/run-canonical-browser.mjs --config playwright.catalog-performance.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@prisma/client": "^6.19.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
