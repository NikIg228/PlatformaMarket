{
  "name": "@marketplace/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prepare:web": "node ../../scripts/prepare-unified-web.mjs",
    "dev": "npm run prepare:web && next dev --port 3000 --hostname 127.0.0.1",
    "build": "npm run prepare:web && next build --webpack",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.4",
    "@fluentui/react-icons": "^2.0.311",
    "@marketplace/api-client": "0.0.0",
    "@marketplace/schemas": "0.0.0",
    "@marketplace/ui": "0.0.0",
    "next": "16.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
