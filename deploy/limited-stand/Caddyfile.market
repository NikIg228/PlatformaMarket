{$MARKET_DOMAIN} {
  encode zstd gzip
  header {
    X-Robots-Tag "noindex, nofollow, noarchive"
    Cache-Control "no-store, private"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Strict-Transport-Security "max-age=31536000"
    X-Platforma-Environment "limited-test-stand"
    -Server
  }
  route {
    @gate path /_stand/access /_stand/logout
    handle @gate {
      reverse_proxy 172.30.90.12:8080 {
        header_up X-Stand-Client {remote_host}
      }
    }
    forward_auth 172.30.90.12:8080 {
      uri /verify
    }
    handle /api/* {
      request_body {
        max_size 26797740
      }
      reverse_proxy 172.30.90.10:4000
    }
    handle {
      reverse_proxy 172.30.90.11:3000
    }
  }
}
