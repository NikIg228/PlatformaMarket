{
  "version": "market-components-v1",
  "tokens": {
    "--dm-radius-field": "8px",
    "--dm-radius-button": "8px",
    "--dm-radius-card": "12px",
    "--dm-radius-section": "12px",
    "--dm-radius-dialog": "16px",
    "--dm-control-default": "44px",
    "--dm-control-compact": "32px",
    "--dm-space-1": "4px",
    "--dm-space-2": "8px",
    "--dm-space-3": "12px",
    "--dm-space-4": "16px",
    "--dm-space-6": "24px",
    "--dm-space-8": "32px",
    "--dm-shadow-card": "0 1px 3px rgb(23 32 30 / 6%)",
    "--dm-shadow-overlay": "0 12px 28px rgb(23 32 30 / 16%)",
    "--dm-radius-pill": "999px",
    "--dm-radius-circle": "50%",
    "--dm-space-micro": "2px",
    "--dm-space-10": "40px",
    "--dm-space-12": "48px",
    "--dm-space-14": "56px",
    "--dm-space-16": "64px",
    "--dm-space-20": "80px",
    "--dm-space-24": "96px",
    "--dm-space-28": "112px",
    "--dm-space-32": "128px",
    "--dm-font-size-micro": "10px",
    "--dm-font-size-caption": "12px",
    "--dm-font-size-body": "14px",
    "--dm-font-size-body-lg": "16px",
    "--dm-font-size-subtitle": "18px",
    "--dm-font-size-title": "20px",
    "--dm-font-size-heading": "24px",
    "--dm-font-size-page-sm": "28px",
    "--dm-font-size-page": "32px",
    "--dm-font-size-display-sm": "40px",
    "--dm-font-size-display": "48px",
    "--dm-font-size-display-lg": "56px",
    "--dm-font-size-display-xl": "64px",
    "--dm-font-size-display-2xl": "80px",
    "--dm-font-size-display-3xl": "96px",
    "--dm-font-weight-regular": "400",
    "--dm-font-weight-medium": "500",
    "--dm-font-weight-semibold": "600",
    "--dm-font-weight-bold": "700",
    "--dm-font-weight-heavy": "800",
    "--dm-line-solid": "1",
    "--dm-line-display": "1.05",
    "--dm-line-heading": "1.25",
    "--dm-line-compact": "1.4",
    "--dm-line-body": "1.5",
    "--dm-line-relaxed": "1.65",
    "--dm-tracking-heading": "-.035em",
    "--dm-tracking-label": ".06em",
    "--dm-tracking-normal": "0",
    "--dm-tab-indicator-height": "3px"
  },
  "notificationCards": {
    "version": "solid-card-v1",
    "radius": "--dm-radius-card",
    "padding": "--dm-space-4",
    "gap": "--dm-space-3",
    "titleSize": "--dm-font-size-body",
    "descriptionSize": "--dm-font-size-body",
    "titleWeight": "--dm-font-weight-semibold",
    "shadow": "--dm-shadow-overlay",
    "warningFill": "warning.toast",
    "successFill": "brand.default",
    "errorFill": "danger.content",
    "infoFill": "info.content",
    "persistentStates": "no-auto-dismiss",
    "actionResultDurationMs": 5000
  },
  "controlStates": {
    "version": "neutral-fill-v1",
    "rest": "surface.subtle",
    "hover": "surface.hover",
    "pressed": "brand.soft",
    "open": "brand.soft",
    "selected": "brand.soft",
    "border": "transparent",
    "movement": "none",
    "keyboardFocus": "focus.ring",
    "invalidBorder": "danger.content",
    "disabledFill": "disabled.surface"
  },
  "loadingState": {
    "version": "subject-spinner-v1",
    "adapter": "LoadingState",
    "blockSpinner": "Fluent.medium",
    "inlineSpinner": "Fluent.tiny",
    "blockLayout": "mp-state",
    "inlineRoot": "span",
    "labelPosition": "after",
    "role": "status",
    "live": "polite",
    "label": "localized-action-and-subject",
    "initialWorkspace": "single-cabinet-loading-state",
    "refresh": "retain-same-context-data-and-show-inline-status"
  },
  "categoryTabs": {
    "version": "underline-v1",
    "rest": "transparent",
    "hover": "transparent",
    "pressed": "transparent",
    "selected": "transparent",
    "indicator": "brand.default",
    "indicatorThickness": "--dm-tab-indicator-height",
    "indicatorInset": "--dm-space-3",
    "keyboardFocus": "preserve-visible-focus",
    "minHeight": "--dm-control-default"
  }
}
